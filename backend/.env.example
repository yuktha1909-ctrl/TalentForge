# Project Settings
PROJECT_NAME="Recruiter AI Agent Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL by default, SQLite fallback supported)
# PostgreSQL: postgresql://username:password@localhost:5432/recruiter_ai
DATABASE_URL="sqlite:///./recruiter_ai.db"

# Redis Configuration (Optional / Fallback to In-Memory if unreachable)
REDIS_URL="redis://localhost:6379/0"

# JWT Authentication
SECRET_KEY="super-secret-jwt-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM / AI Configuration (LangGraph + OpenAI)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
