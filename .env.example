# Project Configuration
PROJECT_NAME="Recruiter AI Agent Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# PostgreSQL Database Configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="recruiter_db"
DATABASE_URL="postgresql://postgres:your_postgres_password_here@localhost:5432/recruiter_db"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# JWT Authentication Security Key
SECRET_KEY="generate-a-strong-jwt-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM / OpenAI API Key Configuration
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
